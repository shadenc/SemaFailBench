# OpenAI-compatible vLLM endpoint (healthy server, GPU 0).
# On this Mac, use scripts/gpu/tunnel.sh so localhost:8000 is the RunPod server.
SFB_BASE_URL=http://127.0.0.1:8000/v1
SFB_API_KEY=EMPTY
SFB_MODEL=Qwen/Qwen2.5-7B-Instruct

# Optional paired faulty server (GPU 1).
SFB_FAULT_BASE_URL=http://127.0.0.1:8001/v1

# RunPod SSH (this Mac → pod). Update if the pod is recreated.
SFB_RUNPOD_SSH=qp386qvf6p72gg-64411ac1@ssh.runpod.io
SFB_RUNPOD_KEY=~/.ssh/sfb_runpod
# Direct TCP SSH for tunnel + GPU metrics (Connect tab on RunPod).
SFB_RUNPOD_TCP_HOST=213.173.111.179
SFB_RUNPOD_TCP_PORT=29086

# F1 quantization fault (AWQ). Used by bootstrap_f1.sh and run_fault_f1.py
SFB_F1_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
SFB_F1_QUANTIZATION=awq

# F2 checkpoint version regression (wrong model-version artifact). Used by bootstrap_f2.sh
SFB_F2_EXPECTED_MODEL=Qwen/Qwen2.5-7B-Instruct
SFB_F2_ACTUAL_MODEL=Qwen/Qwen2-7B-Instruct
SFB_F2_REVISION=f2826a00ceef68f0f2b946d945ecc0477ce4450c
SFB_F2_SERVED_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
SFB_HEALTHY_REVISION=a09a35458c702b33eeacc393d103063234e8bc28
# Frozen healthy tokenizer for isolated F2 (must match healthy baseline)
SFB_F2_TOKENIZER=Qwen/Qwen2.5-7B-Instruct
SFB_F2_TOKENIZER_REVISION=a09a35458c702b33eeacc393d103063234e8bc28

# F3 tokenizer–checkpoint mismatch. Used by bootstrap_f3.sh
SFB_F3_MODEL=Qwen/Qwen2.5-7B-Instruct
SFB_F3_MODEL_REVISION=a09a35458c702b33eeacc393d103063234e8bc28
SFB_F3_TOKENIZER=Qwen/Qwen2-7B-Instruct
SFB_F3_TOKENIZER_REVISION=f2826a00ceef68f0f2b946d945ecc0477ce4450c
SFB_F3_SERVED_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# Optional override of repo root (defaults to this package root).
# SFB_ROOT=
