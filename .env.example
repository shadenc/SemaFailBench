# OpenAI-compatible vLLM endpoint (healthy server, GPU 0).
# On this Mac, use scripts/gpu/tunnel.sh so localhost:8000 is the RunPod server.
SFB_BASE_URL=http://127.0.0.1:8000/v1
SFB_API_KEY=EMPTY
SFB_MODEL=Qwen/Qwen2.5-7B-Instruct

# Optional paired faulty server (GPU 1).
SFB_FAULT_BASE_URL=http://127.0.0.1:8001/v1

# RunPod SSH (this Mac → pod). Update if the pod is recreated.
SFB_RUNPOD_SSH=qp386qvf6p72gg-64411ac1@ssh.runpod.io
SFB_RUNPOD_KEY=~/.ssh/sfb_runpod
# Direct TCP SSH for tunnel + GPU metrics (Connect tab on RunPod).
SFB_RUNPOD_TCP_HOST=213.173.111.179
SFB_RUNPOD_TCP_PORT=29086

# F1 quantization fault (AWQ). Used by bootstrap_f1.sh and run_fault_f1.py
SFB_F1_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
SFB_F1_QUANTIZATION=awq

# Optional override of repo root (defaults to this package root).
# SFB_ROOT=
